{"title":"Aurélie — Your Bag","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  .cart-layout {\n    display: grid; grid-template-columns: 1.5fr 1fr; gap: 64px;\n    padding: 64px 0 130px; align-items: start;\n  }\n  @media (max-width: 980px) { .cart-layout { grid-template-columns: 1fr; gap: 40px; } }\n\n  .cart-item {\n    display: grid; grid-template-columns: 110px 1fr auto; gap: 24px;\n    padding: 28px 0; border-bottom: 1px solid rgba(162, 142, 102, 0.22);\n    align-items: center;\n  }\n  .cart-item:first-child { padding-top: 0; }\n  .cart-item .thumb {\n    aspect-ratio: 4/5; border-radius: 18px; overflow: hidden; background: var(--bg-warm);\n  }\n  .cart-item .thumb img { width: 100%; height: 100%; object-fit: cover; }\n  .cart-item .name {\n    font-family: 'Playfair Display', serif;\n    font-size: 20px; font-weight: 500; color: var(--navy); margin: 0 0 4px;\n  }\n  .cart-item .karat { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 14px; }\n  .cart-item .row2 { display: flex; align-items: center; gap: 20px; }\n  .qty {\n    display: inline-flex; align-items: center;\n    border: 1px solid rgba(17, 27, 67, 0.16); border-radius: var(--r-pill);\n  }\n  .qty button { width: 38px; height: 40px; font-size: 16px; color: var(--navy); }\n  .qty .n { min-width: 28px; text-align: center; font-weight: 600; color: var(--navy); font-size: 14px; }\n  .cart-item .remove {\n    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;\n    color: var(--ink-soft); border-bottom: 1px solid rgba(162, 142, 102, 0.4);\n    padding-bottom: 2px; transition: color var(--t) var(--ease);\n  }\n  .cart-item .remove:hover { color: var(--gold); }\n  .cart-item .price {\n    font-family: 'Playfair Display', serif;\n    font-size: 22px; font-weight: 500; color: var(--navy); white-space: nowrap;\n    justify-self: end;\n  }\n  .continue { margin-top: 28px; display: inline-block; }\n\n  /* Summary */\n  .summary {\n    position: sticky; top: 110px;\n    background: var(--bg-warm); border-radius: var(--r-md);\n    padding: 36px;\n  }\n  .summary h2 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: 26px; color: var(--navy);\n    margin: 0 0 26px;\n  }\n  .sum-row { display: flex; justify-content: space-between; font-size: 14.5px; color: var(--ink-soft); padding: 9px 0; }\n  .sum-row b { color: var(--navy); font-weight: 600; }\n  .sum-row .free { color: var(--gold); font-weight: 600; }\n  .sum-total {\n    display: flex; justify-content: space-between; align-items: baseline;\n    border-top: 1px solid rgba(162, 142, 102, 0.35);\n    margin-top: 14px; padding-top: 20px; margin-bottom: 26px;\n  }\n  .sum-total .lbl { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--navy); font-weight: 600; }\n  .sum-total .amt { font-family: 'Playfair Display', serif; font-size: 30px; font-weight: 500; color: var(--navy); }\n  .summary .cta-btn { width: 100%; margin-bottom: 18px; }\n  .promo { display: flex; gap: 10px; margin-bottom: 24px; }\n  .promo input {\n    flex: 1; padding: 13px 16px; border-radius: var(--r-pill);\n    border: 1px solid rgba(17, 27, 67, 0.16); background: #fff; color: var(--navy);\n    font-family: inherit; font-size: 13px;\n  }\n  .promo input:focus { outline: 0; border-color: var(--gold); }\n  .promo button {\n    padding: 13px 22px; border-radius: var(--r-pill);\n    border: 1px solid rgba(17, 27, 67, 0.2); color: var(--navy);\n    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600;\n    transition: border-color var(--t) var(--ease);\n  }\n  .promo button:hover { border-color: var(--gold); }\n  .summary .trust-pills { justify-content: center; }\n  @media (max-width: 640px) {\n    .cart-item { grid-template-columns: 90px 1fr; }\n    .cart-item .price { grid-column: 2; justify-self: start; }\n  }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<section class=\"page-hero\">\n  <div class=\"wrap\">\n    <div class=\"breadcrumb\">\n      <a href=\"Shail.html\">Home</a><span class=\"sep\">/</span><span class=\"here\">Bag</span>\n    </div>\n    <h1>Your <em>bag.</em></h1>\n    <p class=\"lede\">2 pieces, reserved for the next 48 hours at today's gold rate.</p>\n  </div>\n</section>\n\n<div class=\"wrap\">\n  <div class=\"cart-layout\">\n\n    <!-- ITEMS -->\n    <div class=\"reveal\">\n      <div class=\"cart-item\">\n        <a class=\"thumb\" href=\"product.html\">\n          <img src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=400&h=500&fit=crop&auto=format&q=80\" alt=\"Solène drop earrings\" />\n        </a>\n        <div>\n          <h3 class=\"name\"><a href=\"product.html\">Solène Drop Earrings</a></h3>\n          <div class=\"karat\">22k Gold · 0.4ct Diamond</div>\n          <div class=\"row2\">\n            <div class=\"qty\">\n              <button aria-label=\"Decrease\">−</button><span class=\"n\">1</span><button aria-label=\"Increase\">+</button>\n            </div>\n            <button class=\"remove\">Remove</button>\n          </div>\n        </div>\n        <div class=\"price\">₹ 86,400</div>\n      </div>\n\n      <div class=\"cart-item\">\n        <a class=\"thumb\" href=\"product.html\">\n          <img src=\"https://images.unsplash.com/photo-1573408301185-9146fe634ad0?w=400&h=500&fit=crop&auto=format&q=80\" alt=\"Aria stacking band\" />\n        </a>\n        <div>\n          <h3 class=\"name\"><a href=\"product.html\">Aria Stacking Band</a></h3>\n          <div class=\"karat\">18k Gold · Diamond Pavé · Size 12</div>\n          <div class=\"row2\">\n            <div class=\"qty\">\n              <button aria-label=\"Decrease\">−</button><span class=\"n\">1</span><button aria-label=\"Increase\">+</button>\n            </div>\n            <button class=\"remove\">Remove</button>\n          </div>\n        </div>\n        <div class=\"price\">₹ 38,200</div>\n      </div>\n\n      <a class=\"text-link continue\" href=\"shop.html\">← Continue shopping</a>\n    </div>\n\n    <!-- SUMMARY -->\n    <aside class=\"summary reveal delay-1\">\n      <h2>Order summary</h2>\n      <div class=\"sum-row\"><span>Subtotal (2 pieces)</span><b>₹ 1,24,600</b></div>\n      <div class=\"sum-row\"><span>Insured shipping</span><span class=\"free\">Free</span></div>\n      <div class=\"sum-row\"><span>Taxes</span><b>Included</b></div>\n      <div class=\"sum-total\">\n        <span class=\"lbl\">Total</span>\n        <span class=\"amt\">₹ 1,24,600</span>\n      </div>\n      <a class=\"cta-btn\" href=\"checkout.html\">Secure checkout <span class=\"arrow\"></span></a>\n      <div class=\"promo\">\n        <input type=\"text\" placeholder=\"Gift card or code\" />\n        <button>Apply</button>\n      </div>\n      <div class=\"trust-pills\">\n        <span>BIS Hallmark</span><span>15-Day Returns</span><span>Insured Delivery</span>\n      </div>\n    </aside>\n\n  </div>\n</div>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"code":"\n  // Simple qty steppers\n  document.querySelectorAll('.qty').forEach(q => {\n    const n = q.querySelector('.n');\n    const [minus, , plus] = q.children;\n    minus.addEventListener('click', () => { n.textContent = Math.max(1, +n.textContent - 1); });\n    plus.addEventListener('click', () => { n.textContent = Math.min(5, +n.textContent + 1); });\n  });\n  // Remove rows\n  document.querySelectorAll('.cart-item .remove').forEach(r => {\n    r.addEventListener('click', () => {\n      const item = r.closest('.cart-item');\n      item.style.transition = 'opacity 0.4s'; item.style.opacity = 0;\n      setTimeout(() => item.remove(), 380);\n    });\n  });\n","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}