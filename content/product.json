{"title":"Aurélie — Solène Drop Earrings","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  /* ====== PDP LAYOUT ====== */\n  .pdp {\n    display: grid;\n    grid-template-columns: 1.1fr 1fr;\n    gap: 72px;\n    padding: 140px 0 96px;\n    align-items: start;\n  }\n  @media (max-width: 980px) {\n    .pdp { grid-template-columns: 1fr; gap: 40px; padding-top: 110px; }\n  }\n\n  /* Gallery */\n  .gallery { position: sticky; top: 110px; }\n  @media (max-width: 980px) { .gallery { position: static; } }\n  .gallery .main {\n    aspect-ratio: 4/5;\n    border-radius: var(--r-md);\n    overflow: hidden;\n    background: var(--bg-warm);\n    position: relative;\n  }\n  .gallery .main img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.4s var(--ease); }\n  .gallery .main video { width: 100%; height: 100%; object-fit: cover; display: none; }\n  .gallery .main.video-mode img { display: none; }\n  .gallery .main.video-mode video { display: block; }\n  .gallery .main .badge {\n    position: absolute; top: 20px; left: 20px;\n    background: var(--cream); color: var(--navy);\n    padding: 7px 14px; border-radius: var(--r-pill);\n    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 600;\n  }\n  .thumbs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-top: 14px; }\n  .thumbs button {\n    aspect-ratio: 1/1; border-radius: 16px; overflow: hidden;\n    border: 1.5px solid transparent; padding: 0;\n    transition: border-color var(--t) var(--ease);\n    position: relative;\n  }\n  .thumbs button img { width: 100%; height: 100%; object-fit: cover; }\n  .thumbs button.active { border-color: var(--gold); }\n  .thumbs button:hover { border-color: var(--gold-soft); }\n  .thumbs button .play-ov {\n    position: absolute; inset: 0;\n    display: flex; align-items: center; justify-content: center;\n    background: rgba(17, 27, 67, 0.35);\n  }\n  .thumbs button .play-ov .tri {\n    width: 34px; height: 34px; border-radius: 999px;\n    background: rgba(251, 248, 243, 0.92);\n    display: inline-flex; align-items: center; justify-content: center;\n  }\n  .thumbs button .play-ov .tri::after {\n    content: ''; margin-left: 3px;\n    border-left: 9px solid var(--navy);\n    border-top: 6px solid transparent;\n    border-bottom: 6px solid transparent;\n  }\n\n  /* Info column */\n  .pinfo .collection {\n    font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase;\n    color: var(--gold); font-weight: 500; margin-bottom: 16px;\n    display: inline-block;\n  }\n  .pinfo h1 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: clamp(34px, 3.6vw, 52px);\n    line-height: 1.05; letter-spacing: -0.015em;\n    color: var(--navy); margin: 0 0 14px;\n  }\n  .pinfo .rating { font-size: 13px; color: var(--ink-soft); margin-bottom: 22px; }\n  .pinfo .rating .stars { color: var(--gold); letter-spacing: 3px; margin-right: 8px; }\n  .pinfo .price-line { display: flex; align-items: baseline; gap: 14px; margin-bottom: 8px; }\n  .pinfo .price {\n    font-family: 'Playfair Display', serif;\n    font-size: 34px; font-weight: 500; color: var(--navy);\n  }\n  .pinfo .tax-note { font-size: 12px; color: var(--ink-soft); margin-bottom: 26px; }\n  .pinfo .desc { font-size: 15px; line-height: 1.8; color: var(--ink-soft); max-width: 480px; margin: 0 0 32px; }\n\n  .opt-label {\n    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;\n    color: var(--navy); font-weight: 600; margin-bottom: 12px;\n    display: flex; justify-content: space-between; align-items: baseline;\n  }\n  .opt-label a { font-size: 11px; color: var(--gold); border-bottom: 1px solid var(--gold); letter-spacing: 0.1em; }\n  .metal-row { display: flex; gap: 10px; margin-bottom: 28px; }\n  .metal-chip {\n    display: inline-flex; align-items: center; gap: 10px;\n    padding: 11px 20px; border-radius: var(--r-pill);\n    border: 1px solid rgba(17, 27, 67, 0.16); color: var(--ink-soft);\n    font-size: 13px; font-weight: 500;\n    transition: all var(--t) var(--ease);\n  }\n  .metal-chip .dot { width: 14px; height: 14px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.08); }\n  .metal-chip:hover { border-color: var(--gold); color: var(--navy); }\n  .metal-chip.checked { border-color: var(--navy); color: var(--navy); box-shadow: 0 6px 16px rgba(17, 27, 67, 0.08); }\n\n  .buy-row { display: flex; gap: 14px; margin-bottom: 14px; flex-wrap: wrap; }\n  .qty {\n    display: inline-flex; align-items: center;\n    border: 1px solid rgba(17, 27, 67, 0.16); border-radius: var(--r-pill);\n  }\n  .qty button { width: 46px; height: 54px; font-size: 18px; color: var(--navy); }\n  .qty .n { min-width: 34px; text-align: center; font-weight: 600; color: var(--navy); }\n  .buy-row .cta-btn { flex: 1; min-width: 220px; }\n  .viewing-link { margin-bottom: 34px; display: inline-block; }\n\n  .pdp-trust { margin-bottom: 40px; }\n\n  .pdp-accs { border-top: 1px solid rgba(162, 142, 102, 0.25); }\n\n  /* Recs */\n  .recs { padding: 40px 0 130px; }\n  .recs .head { display: flex; align-items: end; justify-content: space-between; margin-bottom: 48px; gap: 32px; }\n  .recs h2 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: clamp(28px, 3.4vw, 44px);\n    line-height: 1.05; color: var(--navy); margin: 12px 0 0;\n    letter-spacing: -0.01em;\n  }\n  .recs h2 em { font-style: italic; color: var(--gold); font-weight: 400; }\n  .recs-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }\n  @media (max-width: 1100px) { .recs-grid { grid-template-columns: repeat(2, 1fr); } }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<div class=\"wrap\">\n  <section class=\"pdp\">\n\n    <!-- GALLERY -->\n    <div class=\"gallery reveal\">\n      <div class=\"main\" id=\"galleryMain\">\n        <span class=\"badge\">New</span>\n        <img id=\"mainImg\" src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=1100&h=1375&fit=crop&auto=format&q=85\" alt=\"Solène drop earrings — front view\" />\n        <video id=\"mainVid\" src=\"assets/product-video-1.mp4\" playsinline loop muted controls preload=\"none\"></video>\n      </div>\n      <div class=\"thumbs\" id=\"thumbs\">\n        <button class=\"active\" data-type=\"img\" data-src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=1100&h=1375&fit=crop&auto=format&q=85\"><img src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=300&h=300&fit=crop&auto=format&q=70\" alt=\"Front view\" /></button>\n        <button data-type=\"video\" data-src=\"assets/product-video-1.mp4\"><img src=\"https://images.unsplash.com/photo-1633934542430-0905ccb5f050?w=300&h=300&fit=crop&auto=format&q=70\" alt=\"Watch the film\" /><span class=\"play-ov\"><span class=\"tri\"></span></span></button>\n        <button data-type=\"video\" data-src=\"assets/product-video-2.mp4\"><img src=\"https://images.unsplash.com/photo-1535556116002-6281ff3e9f36?w=300&h=300&fit=crop&auto=format&q=70\" alt=\"On the bench\" /><span class=\"play-ov\"><span class=\"tri\"></span></span></button>\n        <button data-type=\"img\" data-src=\"https://images.unsplash.com/photo-1535556116002-6281ff3e9f36?w=1100&h=1375&fit=crop&auto=format&q=85\"><img src=\"https://images.unsplash.com/photo-1535556116002-6281ff3e9f36?w=300&h=300&fit=crop&auto=format&q=70\" alt=\"Worn on model\" /></button>\n        <button data-type=\"img\" data-src=\"https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=1100&h=1375&fit=crop&auto=format&q=85\"><img src=\"https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=300&h=300&fit=crop&auto=format&q=70\" alt=\"Packaging\" /></button>\n      </div>\n    </div>\n\n    <!-- INFO -->\n    <div class=\"pinfo reveal delay-1\">\n      <div class=\"breadcrumb\" style=\"margin-bottom: 22px;\">\n        <a href=\"Shail.html\">Home</a><span class=\"sep\">/</span>\n        <a href=\"shop.html\">Shop</a><span class=\"sep\">/</span>\n        <span class=\"here\">Solène Drop Earrings</span>\n      </div>\n      <a class=\"collection\" href=\"shop.html\">The Solène Collection</a>\n      <h1>Solène Drop Earrings</h1>\n      <div class=\"rating\"><span class=\"stars\">★★★★★</span> 4.9 · 124 reviews</div>\n      <div class=\"price-line\"><span class=\"price\">₹ 86,400</span></div>\n      <div class=\"tax-note\">Inclusive of all taxes · Free insured shipping across India</div>\n      <p class=\"desc\">\n        A sculpted drop in solid 22k gold, holding a 0.4&nbsp;carat ethically sourced diamond. Hand-finished over three weeks at our Jaipur atelier — light enough for every day, considered enough for an heirloom.\n      </p>\n\n      <div class=\"opt-label\"><span>Metal</span></div>\n      <div class=\"metal-row\" id=\"metalRow\">\n        <button class=\"metal-chip checked\" data-value=\"22k\"><span class=\"dot\" style=\"background: linear-gradient(135deg, #d9bd7e, #a8842f);\"></span>22k Gold</button>\n        <button class=\"metal-chip\" data-value=\"18k\"><span class=\"dot\" style=\"background: linear-gradient(135deg, #e6cfa0, #c2a24f);\"></span>18k Gold</button>\n        <button class=\"metal-chip\" data-value=\"rose\"><span class=\"dot\" style=\"background: linear-gradient(135deg, #ecc5b2, #c98d72);\"></span>Rose Gold</button>\n      </div>\n\n      <div class=\"buy-row\">\n        <div class=\"qty\">\n          <button id=\"qMinus\" aria-label=\"Decrease quantity\">−</button>\n          <span class=\"n\" id=\"qty\">1</span>\n          <button id=\"qPlus\" aria-label=\"Increase quantity\">+</button>\n        </div>\n        <a class=\"cta-btn\" href=\"cart.html\" id=\"addToBag\">Add to bag <span class=\"arrow\"></span></a>\n      </div>\n      <a class=\"text-link viewing-link\" href=\"contact.html\">Or book a private viewing</a>\n\n      <div class=\"trust-pills pdp-trust\">\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6Z\"/></svg>BIS Hallmarked</span>\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8 12 3 3 5-6\"/></svg>Certified Diamond</span>\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 12a9 9 0 0 1 15-6.7L21 8\"/><path d=\"M21 3v5h-5\"/></svg>15-Day Returns</span>\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 8v4l3 2\"/><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>Lifetime Service</span>\n      </div>\n\n      <div class=\"pdp-accs\">\n        <details class=\"acc\" open>\n          <summary>Details <span class=\"chev\"></span></summary>\n          <div class=\"acc-body\">\n            <ul>\n              <li>22k solid gold, 4.2 g per pair</li>\n              <li>0.4 ct round brilliant diamond, VS clarity, F–G colour</li>\n              <li>Secure omega backs, hand-polished inside and out</li>\n              <li>Numbered and signed by master karigar Vinod Sharma</li>\n            </ul>\n          </div>\n        </details>\n        <details class=\"acc\">\n          <summary>Materials &amp; care <span class=\"chev\"></span></summary>\n          <div class=\"acc-body\">\n            <p>Wipe gently with the muslin cloth included in your box. Avoid perfume and hairspray contact. Complimentary professional polishing at the atelier, for life.</p>\n          </div>\n        </details>\n        <details class=\"acc\">\n          <summary>Shipping &amp; returns <span class=\"chev\"></span></summary>\n          <div class=\"acc-body\">\n            <p>Free, fully insured shipping across India in tamper-evident packaging — delivered in 3–5 working days. 15-day no-questions returns with doorstep pickup.</p>\n          </div>\n        </details>\n        <details class=\"acc\">\n          <summary>Certification <span class=\"chev\"></span></summary>\n          <div class=\"acc-body\">\n            <p>Every piece carries a BIS hallmark and ships with an SGL diamond certificate and the karigar's signed commission card.</p>\n          </div>\n        </details>\n      </div>\n    </div>\n  </section>\n</div>\n\n<!-- RECOMMENDATIONS -->\n<section class=\"recs\">\n  <div class=\"wrap\">\n    <div class=\"head reveal\">\n      <div>\n        <span class=\"eyebrow\">Complete the look</span>\n        <h2>You may also <em>love</em>.</h2>\n      </div>\n      <a class=\"text-link\" href=\"shop.html\">Shop all</a>\n    </div>\n    <div class=\"recs-grid\">\n      <a class=\"product reveal\" href=\"product.html\">\n        <div class=\"imgbox\">\n          <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Mira solitaire pendant\" loading=\"lazy\" />\n        </div>\n        <div class=\"info\">\n          <div><h4 class=\"name\">Mira Solitaire Pendant</h4><div class=\"karat\">18k Gold · 0.5ct</div></div>\n          <div class=\"price\">₹ 1,18,000</div>\n        </div>\n      </a>\n      <a class=\"product reveal delay-1\" href=\"product.html\">\n        <div class=\"imgbox\">\n          <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1573408301185-9146fe634ad0?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Aria stacking band\" loading=\"lazy\" />\n        </div>\n        <div class=\"info\">\n          <div><h4 class=\"name\">Aria Stacking Band</h4><div class=\"karat\">18k Gold · Pavé</div></div>\n          <div class=\"price\">₹ 38,200</div>\n        </div>\n      </a>\n      <a class=\"product reveal delay-2\" href=\"product.html\">\n        <div class=\"imgbox\">\n          <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1583292650898-7d22cd27ca6f?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Lumière tennis bracelet\" loading=\"lazy\" />\n        </div>\n        <div class=\"info\">\n          <div><h4 class=\"name\">Lumière Tennis Bracelet</h4><div class=\"karat\">18k Gold · VS</div></div>\n          <div class=\"price\">₹ 1,42,000</div>\n        </div>\n      </a>\n      <a class=\"product reveal delay-2\" href=\"product.html\">\n        <div class=\"imgbox\">\n          <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1576092762791-dd9e2220abd1?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Ila pearl studs\" loading=\"lazy\" />\n        </div>\n        <div class=\"info\">\n          <div><h4 class=\"name\">Ila Pearl Studs</h4><div class=\"karat\">18k Gold · Akoya</div></div>\n          <div class=\"price\">₹ 19,800</div>\n        </div>\n      </a>\n    </div>\n  </div>\n</section>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"code":"\n  // Gallery — images + product films\n  const mainImg = document.getElementById('mainImg');\n  const mainVid = document.getElementById('mainVid');\n  const galleryMain = document.getElementById('galleryMain');\n  document.querySelectorAll('#thumbs button').forEach(b => {\n    b.addEventListener('click', () => {\n      document.querySelectorAll('#thumbs button').forEach(x => x.classList.remove('active'));\n      b.classList.add('active');\n      if (b.dataset.type === 'video') {\n        galleryMain.classList.add('video-mode');\n        if (mainVid.getAttribute('src') !== b.dataset.src) mainVid.src = b.dataset.src;\n        mainVid.play().catch(() => {});\n      } else {\n        galleryMain.classList.remove('video-mode');\n        mainVid.pause();\n        mainImg.style.opacity = 0;\n        setTimeout(() => { mainImg.src = b.dataset.src; mainImg.style.opacity = 1; }, 200);\n      }\n    });\n  });\n  // Metal chips\n  document.querySelectorAll('#metalRow .metal-chip').forEach(c => {\n    c.addEventListener('click', () => {\n      document.querySelectorAll('#metalRow .metal-chip').forEach(x => x.classList.remove('checked'));\n      c.classList.add('checked');\n    });\n  });\n  // Quantity\n  let q = 1;\n  const qEl = document.getElementById('qty');\n  document.getElementById('qPlus').addEventListener('click', () => { q = Math.min(q + 1, 5); qEl.textContent = q; });\n  document.getElementById('qMinus').addEventListener('click', () => { q = Math.max(q - 1, 1); qEl.textContent = q; });\n  // Add to bag → confirmation popup\n  var addBtn = document.getElementById('addToBag');\n  if (addBtn) addBtn.addEventListener('click', function (e) {\n    e.preventDefault();\n    var metal = document.querySelector('#metalRow .metal-chip.checked');\n    if (window.Aurelie && Aurelie.toast) Aurelie.toast({\n      type: 'cart',\n      name: 'Solène Drop Earrings',\n      meta: (metal ? metal.textContent.trim() : '22k Gold') + (q > 1 ? ' · Qty ' + q : ''),\n      price: '₹ 86,400',\n      qty: q,\n      img: 'https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=200&h=240&fit=crop&auto=format&q=70'\n    });\n  });\n","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}