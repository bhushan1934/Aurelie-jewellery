{"title":"Aurélie — The Journal","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  /* ====== JOURNAL — staggered editorial mosaic ====== */\n  .j-hero {\n    position: relative;\n    height: 56vh; min-height: 380px;\n    display: flex; align-items: center; justify-content: center;\n    text-align: center; overflow: hidden;\n  }\n  .j-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n  .j-hero::after { content: ''; position: absolute; inset: 0; background: rgba(9, 13, 28, 0.5); }\n  .j-hero .inner { position: relative; z-index: 2; padding: 0 24px; }\n  .j-hero .eyebrow { color: var(--gold-soft); }\n  .j-hero h1 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500;\n    font-size: clamp(38px, 5vw, 68px);\n    line-height: 1.04; letter-spacing: -0.02em;\n    color: #fff; margin: 16px 0 0;\n  }\n  .j-hero h1 em { font-style: italic; color: var(--gold-soft); font-weight: 400; }\n\n  /* Featured */\n  .j-featured {\n    display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 64px;\n    align-items: center;\n    max-width: 1100px; margin: 0 auto;\n    padding: 88px 0 24px;\n  }\n  @media (max-width: 860px) { .j-featured { grid-template-columns: 1fr; gap: 28px; padding-top: 56px; } }\n  .j-featured .media {\n    aspect-ratio: 16/11; border-radius: var(--r-md); overflow: hidden;\n    position: relative; display: block;\n  }\n  .j-featured .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }\n  .j-featured:hover .media img { transform: scale(1.04); }\n  .j-featured .media .tag {\n    position: absolute; top: 18px; left: 18px;\n    background: rgba(251, 248, 243, 0.94);\n    border: 1px solid rgba(162, 142, 102, 0.3);\n    border-radius: 999px; padding: 8px 16px;\n    font-size: 9.5px; font-weight: 600;\n    letter-spacing: 0.26em; text-transform: uppercase;\n    color: var(--navy);\n  }\n  .kicker {\n    font-size: 10px; font-weight: 600;\n    letter-spacing: 0.26em; text-transform: uppercase;\n    color: var(--gold);\n    display: block; margin-bottom: 10px;\n  }\n  .j-featured h2 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-style: italic;\n    font-size: clamp(26px, 3vw, 40px);\n    line-height: 1.18; letter-spacing: -0.01em;\n    color: var(--navy); margin: 0 0 16px;\n    transition: color var(--t) var(--ease);\n  }\n  .j-featured:hover h2 { color: var(--gold); }\n  .j-featured p.ex { font-size: 15px; line-height: 1.85; color: var(--ink-soft); margin: 0 0 22px; max-width: 42ch; }\n  .j-meta { font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }\n  .j-meta b { color: var(--navy); font-weight: 600; }\n  .j-featured .read {\n    display: inline-flex; align-items: center; gap: 12px;\n    margin-top: 24px;\n    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;\n    color: var(--navy);\n    border-bottom: 1px solid var(--gold); padding-bottom: 4px;\n    transition: gap var(--t) var(--ease), color var(--t) var(--ease);\n  }\n  .j-featured:hover .read { gap: 18px; color: var(--gold); }\n\n  /* Topic chips */\n  .j-chips {\n    display: flex; justify-content: center; flex-wrap: wrap; gap: 8px;\n    padding: 48px 0 0;\n  }\n  .j-chip {\n    padding: 9px 20px; border-radius: 999px;\n    border: 1px solid rgba(17, 27, 67, 0.14);\n    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500;\n    color: var(--ink-soft);\n    transition: all var(--t) var(--ease);\n  }\n  .j-chip:hover { border-color: var(--gold); color: var(--navy); }\n  .j-chip.active { background: var(--navy); border-color: var(--navy); color: #fff; }\n\n  /* Staggered mosaic — no straight sequence */\n  .j-mosaic {\n    max-width: 1060px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    column-gap: 72px;\n    padding: 72px 0 150px;\n  }\n  .j-card { display: block; margin-bottom: 72px; }\n  /* right column floats lower, cards alternate scale/ratio */\n  .j-card:nth-child(even) { transform: translateY(96px); }\n  .j-card:nth-child(4n+1) .media { aspect-ratio: 4/3; }\n  .j-card:nth-child(4n+2) .media { aspect-ratio: 4/5; width: 82%; }\n  .j-card:nth-child(4n+3) .media { aspect-ratio: 1/1; width: 88%; margin-left: auto; }\n  .j-card:nth-child(4n)   .media { aspect-ratio: 16/10; }\n  .j-card .media {\n    border-radius: var(--r-sm); overflow: hidden; margin-bottom: 22px;\n    display: block;\n  }\n  .j-card .media img { width: 100%; height: 106%; object-fit: cover; transition: transform 1s var(--ease); }\n  .j-card:hover .media img { transform: scale(1.045); }\n  .j-card h3 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-style: italic;\n    font-size: clamp(20px, 2.1vw, 26px);\n    line-height: 1.28;\n    color: var(--navy); margin: 0 0 10px;\n    max-width: 24ch;\n    transition: color var(--t) var(--ease);\n  }\n  .j-card:hover h3 { color: var(--gold); }\n  .j-card.hide { display: none; }\n  @media (max-width: 720px) {\n    .j-mosaic { grid-template-columns: 1fr; column-gap: 0; padding-bottom: 120px; }\n    .j-card:nth-child(even) { transform: none; }\n    .j-card { margin-bottom: 56px; }\n  }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<!-- ==================== BANNER ==================== -->\n<section class=\"j-hero\">\n  <img src=\"https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=2000&h=1100&fit=crop&auto=format&q=85\" alt=\"Fine jewellery on cream silk\" />\n  <div class=\"inner\">\n    <span class=\"eyebrow\">The Journal</span>\n    <h1>Stories from the <em>atelier.</em></h1>\n  </div>\n</section>\n\n<div class=\"wrap\">\n\n  <!-- ==================== FEATURED ==================== -->\n  <a class=\"j-featured\" href=\"article.html\">\n    <span class=\"media\">\n      <img src=\"https://images.unsplash.com/photo-1583292650898-7d22cd27ca6f?w=1400&h=963&fit=crop&auto=format&q=85\" alt=\"Hands finishing a bracelet at the atelier bench\" />\n      <span class=\"tag\">Featured</span>\n    </span>\n    <span>\n      <span class=\"kicker\">Craftsmanship</span>\n      <h2>Forty-two pairs of hands: the journey of one earring.</h2>\n      <p class=\"ex\">From the first wax carving to the final mirror polish, a single Solène drop passes through the atelier for three weeks. We followed it, bench by bench.</p>\n      <span class=\"j-meta\"><b>Anaïka Rao</b> · 8 July 2026 · 6 min read</span><br />\n      <span class=\"read\">Read the story <span>→</span></span>\n    </span>\n  </a>\n\n  <!-- ==================== TOPICS ==================== -->\n  <div class=\"j-chips\" id=\"jChips\">\n    <button class=\"j-chip active\" data-topic=\"all\">All stories</button>\n    <button class=\"j-chip\" data-topic=\"Guides\">Guides</button>\n    <button class=\"j-chip\" data-topic=\"Heritage\">Heritage</button>\n    <button class=\"j-chip\" data-topic=\"Care\">Care</button>\n    <button class=\"j-chip\" data-topic=\"People\">People</button>\n  </div>\n\n  <!-- ==================== MOSAIC ==================== -->\n  <div class=\"j-mosaic\">\n\n    <a class=\"j-card\" href=\"journal.html#\">\n      <span class=\"media\"><img src=\"https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=900&h=675&fit=crop&auto=format&q=80\" alt=\"Solitaire ring\" /></span>\n      <span class=\"kicker\">Guides</span>\n      <h3>How to read a BIS hallmark — and why the HUID matters.</h3>\n      <span class=\"j-meta\">2 July 2026 · 4 min</span>\n    </a>\n\n    <a class=\"j-card\" href=\"journal.html#\">\n      <span class=\"media\"><img src=\"https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?w=800&h=1000&fit=crop&auto=format&q=80\" alt=\"Polki bridal set\" /></span>\n      <span class=\"kicker\">Heritage</span>\n      <h3>Polki, kundan, jadau: three words everyone confuses.</h3>\n      <span class=\"j-meta\">24 June 2026 · 5 min</span>\n    </a>\n\n    <a class=\"j-card\" href=\"journal.html#\">\n      <span class=\"media\"><img src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=800&h=800&fit=crop&auto=format&q=80\" alt=\"Drop earrings in daylight\" /></span>\n      <span class=\"kicker\">Care</span>\n      <h3>Everyday gold: what to take off, and when.</h3>\n      <span class=\"j-meta\">15 June 2026 · 3 min</span>\n    </a>\n\n    <a class=\"j-card\" href=\"journal.html#\">\n      <span class=\"media\"><img src=\"https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=1000&h=625&fit=crop&auto=format&q=80\" alt=\"Gold bangles\" /></span>\n      <span class=\"kicker\">Guides</span>\n      <h3>The gold rate, explained like a friend would.</h3>\n      <span class=\"j-meta\">20 May 2026 · 4 min</span>\n    </a>\n\n    <a class=\"j-card\" href=\"journal.html#\">\n      <span class=\"media\"><img src=\"https://images.unsplash.com/photo-1576092762791-dd9e2220abd1?w=900&h=675&fit=crop&auto=format&q=80\" alt=\"Pearl choker\" /></span>\n      <span class=\"kicker\">People</span>\n      <h3>Master karigar Vinod on forty years at one bench.</h3>\n      <span class=\"j-meta\">8 May 2026 · 6 min</span>\n    </a>\n\n  </div>\n\n</div>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"code":"\n  document.querySelectorAll('#jChips .j-chip').forEach(c => {\n    c.addEventListener('click', () => {\n      document.querySelectorAll('#jChips .j-chip').forEach(x => x.classList.remove('active'));\n      c.classList.add('active');\n      const t = c.dataset.topic;\n      const showing = [];\n      document.querySelectorAll('.j-card').forEach(r => {\n        const k = r.querySelector('.kicker').textContent.trim();\n        const show = t === 'all' || k === t;\n        r.classList.toggle('hide', !show);\n        if (show) showing.push(r);\n      });\n      if (window.gsap) gsap.fromTo(showing, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7, stagger: 0.08, ease: 'power3.out', overwrite: 'auto', clearProps: 'opacity,transform' });\n    });\n  });\n\n  // ---- GSAP entrance + scroll animations ----\n  if (window.gsap && window.ScrollTrigger && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Banner: slow cinematic settle\n    gsap.from('.j-hero img', { scale: 1.12, duration: 2.2, ease: 'power2.out' });\n    gsap.from('.j-hero .eyebrow', { opacity: 0, y: 18, duration: 1, delay: 0.25, ease: 'power3.out' });\n    gsap.from('.j-hero h1', { opacity: 0, y: 34, duration: 1.2, delay: 0.4, ease: 'power3.out' });\n\n    // Banner parallax on scroll\n    gsap.to('.j-hero img', {\n      yPercent: 16, ease: 'none',\n      scrollTrigger: { trigger: '.j-hero', start: 'top top', end: 'bottom top', scrub: true }\n    });\n\n    // Featured story\n    gsap.from('.j-featured .media', {\n      opacity: 0, y: 48, duration: 1.1, ease: 'power3.out',\n      scrollTrigger: { trigger: '.j-featured', start: 'top 78%' }\n    });\n    gsap.from('.j-featured .kicker, .j-featured h2, .j-featured p.ex, .j-featured .j-meta, .j-featured .read', {\n      opacity: 0, y: 26, duration: 0.9, stagger: 0.1, delay: 0.15, ease: 'power3.out',\n      scrollTrigger: { trigger: '.j-featured', start: 'top 78%' }\n    });\n\n    // Chips\n    gsap.from('#jChips .j-chip', {\n      opacity: 0, y: 16, duration: 0.6, stagger: 0.05, ease: 'power2.out',\n      scrollTrigger: { trigger: '#jChips', start: 'top 88%' }\n    });\n\n    // Mosaic cards — each drifts up as it enters\n    document.querySelectorAll('.j-mosaic .j-card').forEach((card) => {\n      gsap.from(card, {\n        opacity: 0, y: 56, duration: 1.1, ease: 'power3.out',\n        scrollTrigger: { trigger: card, start: 'top 88%' }\n      });\n      // gentle parallax on the image inside\n      const img = card.querySelector('.media img');\n      if (img) gsap.fromTo(img, { yPercent: -6 }, {\n        yPercent: 6, ease: 'none',\n        scrollTrigger: { trigger: card, start: 'top bottom', end: 'bottom top', scrub: true }\n      });\n    });\n  }\n","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}