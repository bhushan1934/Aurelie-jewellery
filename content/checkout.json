{"title":"Aurélie — Secure Checkout","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  .co-layout {\n    display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px;\n    padding: 64px 0 130px; align-items: start;\n  }\n  @media (max-width: 980px) { .co-layout { grid-template-columns: 1fr; gap: 40px; } }\n\n  /* Steps */\n  .steps {\n    display: flex; align-items: center; gap: 14px;\n    margin-bottom: 44px; flex-wrap: wrap;\n  }\n  .steps .step {\n    display: inline-flex; align-items: center; gap: 10px;\n    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;\n    color: var(--ink-soft);\n  }\n  .steps .step .n {\n    width: 26px; height: 26px; border-radius: 999px;\n    border: 1px solid rgba(17, 27, 67, 0.25);\n    display: inline-flex; align-items: center; justify-content: center;\n    font-size: 12px; font-weight: 600;\n  }\n  .steps .step.active { color: var(--navy); }\n  .steps .step.active .n { background: var(--navy); border-color: var(--navy); color: #fff; }\n  .steps .bar { width: 40px; height: 1px; background: rgba(162, 142, 102, 0.4); }\n\n  .co-form h2 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: 24px; color: var(--navy);\n    margin: 0 0 22px; line-height: 1.2;\n  }\n  .co-block { margin-bottom: 48px; }\n  .pay-note { font-size: 12.5px; color: var(--ink-soft); margin-top: 14px; }\n  .pay-note b { color: var(--navy); font-weight: 600; }\n\n  /* Summary */\n  .co-summary {\n    position: sticky; top: 110px;\n    background: var(--bg-warm); border-radius: var(--r-md); padding: 36px;\n  }\n  .co-summary h2 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: 24px; color: var(--navy); margin: 0 0 24px;\n  }\n  .co-item {\n    display: grid; grid-template-columns: 64px 1fr auto; gap: 16px;\n    align-items: center; padding: 12px 0;\n  }\n  .co-item .thumb { aspect-ratio: 1/1; border-radius: 12px; overflow: hidden; }\n  .co-item .thumb img { width: 100%; height: 100%; object-fit: cover; }\n  .co-item .nm { font-size: 14px; font-weight: 600; color: var(--navy); }\n  .co-item .kt { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }\n  .co-item .pr { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 500; color: var(--navy); white-space: nowrap; }\n  .co-sums { border-top: 1px solid rgba(162, 142, 102, 0.35); margin-top: 16px; padding-top: 16px; }\n  .sum-row { display: flex; justify-content: space-between; font-size: 14px; color: var(--ink-soft); padding: 7px 0; }\n  .sum-row b { color: var(--navy); font-weight: 600; }\n  .sum-row .free { color: var(--gold); font-weight: 600; }\n  .sum-total {\n    display: flex; justify-content: space-between; align-items: baseline;\n    border-top: 1px solid rgba(162, 142, 102, 0.35);\n    margin-top: 10px; padding-top: 18px; margin-bottom: 24px;\n  }\n  .sum-total .lbl { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--navy); font-weight: 600; }\n  .sum-total .amt { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 500; color: var(--navy); }\n  .co-summary .cta-btn { width: 100%; margin-bottom: 18px; }\n  .secure-line {\n    display: flex; align-items: center; justify-content: center; gap: 8px;\n    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft);\n  }\n  .secure-line svg { width: 13px; height: 13px; color: var(--gold); }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<section class=\"page-hero\">\n  <div class=\"wrap\">\n    <div class=\"breadcrumb\">\n      <a href=\"Shail.html\">Home</a><span class=\"sep\">/</span>\n      <a href=\"cart.html\">Bag</a><span class=\"sep\">/</span>\n      <span class=\"here\">Checkout</span>\n    </div>\n    <h1>Secure <em>checkout.</em></h1>\n  </div>\n</section>\n\n<div class=\"wrap\">\n  <div class=\"co-layout\">\n\n    <!-- FORM -->\n    <div class=\"co-form reveal\">\n      <div class=\"steps\">\n        <span class=\"step active\"><span class=\"n\">1</span> Address</span>\n        <span class=\"bar\"></span>\n        <span class=\"step active\"><span class=\"n\">2</span> Payment</span>\n        <span class=\"bar\"></span>\n        <span class=\"step\"><span class=\"n\">3</span> Review</span>\n      </div>\n\n      <div class=\"co-block\">\n        <h2>Contact</h2>\n        <div class=\"field-row\">\n          <div class=\"field\">\n            <label for=\"co-email\">Email</label>\n            <input id=\"co-email\" type=\"email\" placeholder=\"you@example.com\" />\n          </div>\n          <div class=\"field\">\n            <label for=\"co-phone\">Phone</label>\n            <input id=\"co-phone\" type=\"tel\" placeholder=\"+91 98xxx xxxxx\" />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"co-block\">\n        <h2>Shipping address</h2>\n        <div class=\"field-row\">\n          <div class=\"field\">\n            <label for=\"co-fn\">First name</label>\n            <input id=\"co-fn\" type=\"text\" placeholder=\"Ananya\" />\n          </div>\n          <div class=\"field\">\n            <label for=\"co-ln\">Last name</label>\n            <input id=\"co-ln\" type=\"text\" placeholder=\"Sharma\" />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"co-add\">Address</label>\n          <input id=\"co-add\" type=\"text\" placeholder=\"House number, street, area\" />\n        </div>\n        <div class=\"field-row\">\n          <div class=\"field\">\n            <label for=\"co-city\">City</label>\n            <input id=\"co-city\" type=\"text\" placeholder=\"Jaipur\" />\n          </div>\n          <div class=\"field\">\n            <label for=\"co-pin\">PIN code</label>\n            <input id=\"co-pin\" type=\"text\" placeholder=\"302001\" />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"co-state\">State</label>\n          <select id=\"co-state\">\n            <option>Rajasthan</option>\n            <option>Maharashtra</option>\n            <option>Delhi NCR</option>\n            <option>Karnataka</option>\n            <option>Tamil Nadu</option>\n            <option>West Bengal</option>\n            <option>Other</option>\n          </select>\n        </div>\n      </div>\n\n      <div class=\"co-block\">\n        <h2>Payment</h2>\n        <div id=\"payRows\">\n          <div class=\"radio-row checked\" data-pay=\"upi\">\n            <span class=\"rdot\"></span>\n            <span><span class=\"r-name\">UPI</span><br /><span class=\"r-sub\">GPay, PhonePe, Paytm — instant confirmation</span></span>\n          </div>\n          <div class=\"radio-row\" data-pay=\"card\">\n            <span class=\"rdot\"></span>\n            <span><span class=\"r-name\">Credit / debit card</span><br /><span class=\"r-sub\">Visa, Mastercard, RuPay, Amex · EMI available</span></span>\n          </div>\n          <div class=\"radio-row\" data-pay=\"netbanking\">\n            <span class=\"rdot\"></span>\n            <span><span class=\"r-name\">Net banking</span><br /><span class=\"r-sub\">All major Indian banks</span></span>\n          </div>\n          <div class=\"radio-row\" data-pay=\"cod\">\n            <span class=\"rdot\"></span>\n            <span><span class=\"r-name\">Cash on delivery</span><br /><span class=\"r-sub\">Available on orders up to ₹ 1,00,000</span></span>\n          </div>\n        </div>\n        <p class=\"pay-note\"><b>256-bit encrypted.</b> Your payment details never touch our servers — processed by RBI-licensed gateways.</p>\n      </div>\n    </div>\n\n    <!-- SUMMARY -->\n    <aside class=\"co-summary reveal delay-1\">\n      <h2>Your order</h2>\n      <div class=\"co-item\">\n        <div class=\"thumb\"><img src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=200&h=200&fit=crop&auto=format&q=70\" alt=\"Solène drop earrings\" /></div>\n        <div><div class=\"nm\">Solène Drop Earrings</div><div class=\"kt\">22k · Qty 1</div></div>\n        <div class=\"pr\">₹ 86,400</div>\n      </div>\n      <div class=\"co-item\">\n        <div class=\"thumb\"><img src=\"https://images.unsplash.com/photo-1573408301185-9146fe634ad0?w=200&h=200&fit=crop&auto=format&q=70\" alt=\"Aria stacking band\" /></div>\n        <div><div class=\"nm\">Aria Stacking Band</div><div class=\"kt\">18k · Size 12 · Qty 1</div></div>\n        <div class=\"pr\">₹ 38,200</div>\n      </div>\n      <div class=\"co-sums\">\n        <div class=\"sum-row\"><span>Subtotal</span><b>₹ 1,24,600</b></div>\n        <div class=\"sum-row\"><span>Insured shipping</span><span class=\"free\">Free</span></div>\n        <div class=\"sum-row\"><span>Taxes</span><b>Included</b></div>\n      </div>\n      <div class=\"sum-total\">\n        <span class=\"lbl\">Total</span>\n        <span class=\"amt\">₹ 1,24,600</span>\n      </div>\n      <button class=\"cta-btn\">Place order <span class=\"arrow\"></span></button>\n      <div class=\"secure-line\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6Z\"/></svg>\n        Encrypted &amp; insured to your door\n      </div>\n    </aside>\n\n  </div>\n</div>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"code":"\n  document.querySelectorAll('#payRows .radio-row').forEach(r => {\n    r.addEventListener('click', () => {\n      document.querySelectorAll('#payRows .radio-row').forEach(x => x.classList.remove('checked'));\n      r.classList.add('checked');\n    });\n  });\n","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}