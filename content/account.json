{"title":"Aurélie — My Account","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  .acct-hero {\n    padding: 150px 0 48px;\n    background: var(--bg-warm);\n    border-bottom: 1px solid rgba(162, 142, 102, 0.22);\n  }\n  .acct-hero .row { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }\n  .acct-hero h1 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: clamp(30px, 3.6vw, 48px);\n    line-height: 1.05; letter-spacing: -0.015em; color: var(--navy);\n    margin: 0;\n  }\n  .acct-hero h1 em { font-style: italic; color: var(--gold); font-weight: 400; }\n  .acct-hero .sub { font-size: 14px; color: var(--ink-soft); margin-top: 6px; }\n  .acct-hero .sub b { color: var(--gold); font-weight: 600; }\n\n  .acct-layout {\n    display: grid; grid-template-columns: 250px 1fr; gap: 64px;\n    padding: 56px 0 130px; align-items: start;\n  }\n  @media (max-width: 900px) { .acct-layout { grid-template-columns: 1fr; gap: 32px; } }\n\n  /* Sidebar */\n  .acct-nav { position: sticky; top: 110px; }\n  .acct-nav .grp {\n    font-size: 10px; font-weight: 600;\n    letter-spacing: 0.26em; text-transform: uppercase;\n    color: var(--gold);\n    margin: 26px 0 8px;\n  }\n  .acct-nav .grp:first-child { margin-top: 0; }\n  .acct-nav a {\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 10px 4px;\n    font-size: 13.5px; font-weight: 500;\n    color: var(--ink-soft);\n    border-bottom: 1px solid rgba(162, 142, 102, 0.14);\n    transition: color var(--t) var(--ease), padding-left var(--t) var(--ease);\n  }\n  .acct-nav a:hover { color: var(--navy); padding-left: 8px; }\n  .acct-nav a.active { color: var(--navy); font-weight: 600; }\n  .acct-nav a.active::after { content: ''; width: 6px; height: 6px; border-radius: 999px; background: var(--gold); }\n  .acct-nav a .n {\n    font-size: 10px; font-weight: 700; color: var(--navy);\n    background: var(--cream); border-radius: 999px; padding: 2px 8px;\n  }\n  .acct-nav .signout { color: var(--gold); border-bottom: 0; margin-top: 16px; }\n  @media (max-width: 900px) {\n    .acct-nav { position: static; display: flex; overflow-x: auto; gap: 2px; padding-bottom: 8px; }\n    .acct-nav .grp { display: none; }\n    .acct-nav a { border-bottom: 0; white-space: nowrap; padding: 8px 12px; }\n  }\n\n  /* Panels */\n  .panel { margin-bottom: 64px; scroll-margin-top: 110px; }\n  .panel > h2 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: 24px; color: var(--navy);\n    margin: 0 0 20px; line-height: 1.2;\n  }\n  .panel > h2 em { font-style: italic; color: var(--gold); font-weight: 400; }\n\n  /* Stat tiles (dashboard) */\n  .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }\n  @media (max-width: 760px) { .stat-row { grid-template-columns: 1fr 1fr; } }\n  .stat {\n    background: var(--bg-warm); border-radius: var(--r-sm);\n    padding: 22px 24px;\n  }\n  .stat .n { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 500; color: var(--navy); line-height: 1; }\n  .stat .l { font-size: 10.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-top: 8px; font-weight: 600; }\n\n  /* Order cards */\n  .order-card {\n    border: 1px solid rgba(162, 142, 102, 0.25);\n    border-radius: var(--r-sm);\n    padding: 22px 26px;\n    margin-bottom: 14px;\n    display: grid; grid-template-columns: 72px 1fr auto; gap: 22px; align-items: center;\n    background: #fff;\n    transition: border-color var(--t) var(--ease), box-shadow var(--t) var(--ease);\n  }\n  .order-card:hover { border-color: var(--gold); box-shadow: var(--shadow-soft); }\n  .order-card .thumb { aspect-ratio: 1/1; border-radius: 12px; overflow: hidden; background: var(--bg-warm); }\n  .order-card .thumb img { width: 100%; height: 100%; object-fit: cover; }\n  .order-card .o-num { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 3px; }\n  .order-card .o-name { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 500; color: var(--navy); margin: 0 0 3px; }\n  .order-card .o-meta { font-size: 12px; color: var(--ink-soft); }\n  .order-card .o-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }\n  .order-card .o-links { display: flex; gap: 16px; }\n  .order-card .o-links a, .order-card .o-links button {\n    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500;\n    color: var(--navy); border-bottom: 1px solid var(--gold); padding-bottom: 2px;\n    transition: color var(--t) var(--ease);\n  }\n  .order-card .o-links a:hover, .order-card .o-links button:hover { color: var(--gold); }\n  .status {\n    display: inline-flex; align-items: center; gap: 7px;\n    font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600;\n    padding: 5px 11px; border-radius: 999px;\n  }\n  .status .dot { width: 5px; height: 5px; border-radius: 999px; }\n  .status.transit { background: rgba(162, 142, 102, 0.14); color: var(--gold); }\n  .status.transit .dot { background: var(--gold); }\n  .status.delivered { background: rgba(17, 27, 67, 0.07); color: var(--navy); }\n  .status.delivered .dot { background: var(--navy); }\n  @media (max-width: 640px) {\n    .order-card { grid-template-columns: 56px 1fr; }\n    .order-card .o-right { grid-column: 2; align-items: flex-start; }\n  }\n\n  /* Track timeline */\n  .track-strip { grid-column: 1 / -1; border-top: 1px solid rgba(162, 142, 102, 0.22); margin-top: 4px; padding-top: 20px; display: none; }\n  .track-strip.show { display: block; }\n  .tstep { display: flex; gap: 14px; }\n  .tstep .rail { display: flex; flex-direction: column; align-items: center; }\n  .tstep .dot { width: 11px; height: 11px; border-radius: 999px; flex-shrink: 0; border: 1.5px solid rgba(162, 142, 102, 0.5); margin-top: 3px; background: #fff; }\n  .tstep .line { width: 1px; flex: 1; background: rgba(162, 142, 102, 0.3); min-height: 20px; }\n  .tstep:last-child .line { display: none; }\n  .tstep.done .dot { background: var(--gold); border-color: var(--gold); }\n  .tstep.now .dot { background: var(--navy); border-color: var(--navy); box-shadow: 0 0 0 4px rgba(17, 27, 67, 0.12); }\n  .tstep .t-name { font-size: 13px; font-weight: 600; color: var(--navy); }\n  .tstep .t-sub { font-size: 11.5px; color: var(--ink-soft); padding-bottom: 14px; display: block; }\n  .tstep.pending .t-name { color: var(--ink-soft); font-weight: 500; }\n\n  /* Tiles (profile / addresses / wallet etc.) */\n  .tile-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\n  @media (max-width: 640px) { .tile-row { grid-template-columns: 1fr; } }\n  .tile {\n    background: var(--bg-warm); border-radius: var(--r-sm); padding: 24px 26px;\n    position: relative;\n  }\n  .tile.plain { background: #fff; border: 1px solid rgba(162, 142, 102, 0.25); }\n  .tile .t-eyebrow { font-size: 9.5px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 8px; }\n  .tile h3 { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 500; color: var(--navy); margin: 0 0 6px; }\n  .tile p { font-size: 13.5px; line-height: 1.75; color: var(--ink-soft); margin: 0 0 12px; }\n  .tile p b { color: var(--navy); font-weight: 600; }\n  .tile .t-links { display: flex; gap: 16px; flex-wrap: wrap; }\n  .tile .t-links a, .tile .t-links button {\n    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500;\n    color: var(--navy); border-bottom: 1px solid var(--gold); padding-bottom: 2px;\n    transition: color var(--t) var(--ease);\n  }\n  .tile .t-links a:hover, .tile .t-links button:hover { color: var(--gold); }\n  .tile .t-links .danger { color: #8a3030; border-color: rgba(138, 48, 48, 0.4); }\n\n  .add-tile {\n    border: 1.5px dashed rgba(162, 142, 102, 0.5);\n    border-radius: var(--r-sm);\n    display: flex; align-items: center; justify-content: center; gap: 10px;\n    min-height: 120px;\n    color: var(--gold);\n    font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600;\n    transition: all var(--t) var(--ease);\n    background: transparent;\n    width: 100%;\n  }\n  .add-tile:hover { border-color: var(--gold); background: rgba(237, 227, 198, 0.25); }\n\n  /* Notifications */\n  .notif { display: flex; gap: 14px; padding: 16px 4px; border-bottom: 1px solid rgba(162, 142, 102, 0.16); align-items: baseline; }\n  .notif .dot { width: 7px; height: 7px; border-radius: 999px; background: var(--gold); flex-shrink: 0; position: relative; top: -1px; }\n  .notif.read .dot { background: rgba(162, 142, 102, 0.25); }\n  .notif p { margin: 0; font-size: 14px; color: var(--ink-soft); }\n  .notif p b { color: var(--navy); font-weight: 600; }\n  .notif .when { margin-left: auto; font-size: 11px; color: var(--ink-soft); white-space: nowrap; }\n\n  /* Coupons */\n  .coupon {\n    display: flex; align-items: center; justify-content: space-between; gap: 18px;\n    border: 1.5px dashed rgba(162, 142, 102, 0.5);\n    border-radius: var(--r-sm);\n    padding: 18px 22px; margin-bottom: 12px;\n    background: rgba(237, 227, 198, 0.18);\n  }\n  .coupon .code { font-family: 'Manrope', sans-serif; font-weight: 700; letter-spacing: 0.14em; color: var(--navy); font-size: 14px; }\n  .coupon .desc { font-size: 12.5px; color: var(--ink-soft); }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<!-- ==================== HERO / WELCOME ==================== -->\n<section class=\"acct-hero\">\n  <div class=\"wrap\">\n    <div class=\"row\">\n      <div>\n        <h1>Welcome back, <em>Ananya.</em></h1>\n        <div class=\"sub\">Aurélie Circle · Member since 2024 · <b>1,240 reward points</b></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<div class=\"wrap\">\n  <div class=\"acct-layout\">\n\n    <!-- ==================== SIDEBAR ==================== -->\n    <aside class=\"acct-nav\">\n      <span class=\"grp\">Account</span>\n      <a href=\"#dashboard\" class=\"active\">Dashboard</a>\n      <a href=\"#profile\">Profile</a>\n      <a href=\"#addresses\">Addresses</a>\n      <span class=\"grp\">Shopping</span>\n      <a href=\"#orders\">Orders <span class=\"n\">2</span></a>\n      <a href=\"wishlist.html\">Wishlist <span class=\"n\">4</span></a>\n      <a href=\"#coupons\">Coupons <span class=\"n\">2</span></a>\n      <span class=\"grp\">Payments</span>\n      <a href=\"#cards\">Saved cards</a>\n      <a href=\"#wallet\">Wallet &amp; rewards</a>\n      <span class=\"grp\">Updates</span>\n      <a href=\"#notifications\">Notifications <span class=\"n\">3</span></a>\n      <a href=\"#\" class=\"signout\">Logout</a>\n    </aside>\n\n    <!-- ==================== MAIN ==================== -->\n    <main>\n\n      <!-- DASHBOARD -->\n      <section class=\"panel\" id=\"dashboard\">\n        <h2>Your <em>dashboard.</em></h2>\n        <div class=\"stat-row\">\n          <div class=\"stat\"><div class=\"n\">2</div><div class=\"l\">Orders</div></div>\n          <div class=\"stat\"><div class=\"n\">4</div><div class=\"l\">Wishlisted</div></div>\n          <div class=\"stat\"><div class=\"n\">1,240</div><div class=\"l\">Reward points</div></div>\n          <div class=\"stat\"><div class=\"n\">₹ 2,400</div><div class=\"l\">Wallet balance</div></div>\n        </div>\n      </section>\n\n      <!-- ORDERS -->\n      <section class=\"panel\" id=\"orders\">\n        <h2>Current <em>orders.</em></h2>\n        <div class=\"order-card\">\n          <div class=\"thumb\"><img src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=300&h=300&fit=crop&auto=format&q=70\" alt=\"Solène drop earrings\" /></div>\n          <div>\n            <div class=\"o-num\">Order № AUR-2418</div>\n            <h3 class=\"o-name\">Solène Drop Earrings</h3>\n            <div class=\"o-meta\">Placed 4 July 2026 · ₹ 86,400 · Arriving Tuesday, 14 July</div>\n          </div>\n          <div class=\"o-right\">\n            <span class=\"status transit\"><span class=\"dot\"></span>In transit</span>\n            <div class=\"o-links\">\n              <button id=\"trackToggle\">Track</button>\n              <a href=\"#\">Invoice</a>\n            </div>\n          </div>\n          <div class=\"track-strip\" id=\"trackStrip\">\n            <div class=\"tstep done\">\n              <span class=\"rail\"><span class=\"dot\"></span><span class=\"line\"></span></span>\n              <span><span class=\"t-name\">Order placed</span><span class=\"t-sub\">4 July · Payment confirmed</span></span>\n            </div>\n            <div class=\"tstep done\">\n              <span class=\"rail\"><span class=\"dot\"></span><span class=\"line\"></span></span>\n              <span><span class=\"t-name\">Hallmarked &amp; quality checked</span><span class=\"t-sub\">6 July · BIS HUID registered at the atelier</span></span>\n            </div>\n            <div class=\"tstep now\">\n              <span class=\"rail\"><span class=\"dot\"></span><span class=\"line\"></span></span>\n              <span><span class=\"t-name\">In transit — insured</span><span class=\"t-sub\">Left Jaipur 9 July · Sealed, tamper-evident box</span></span>\n            </div>\n            <div class=\"tstep pending\">\n              <span class=\"rail\"><span class=\"dot\"></span><span class=\"line\"></span></span>\n              <span><span class=\"t-name\">Out for delivery</span><span class=\"t-sub\">Expected Tuesday, 14 July · OTP required</span></span>\n            </div>\n          </div>\n        </div>\n\n        <h2 style=\"margin-top: 40px;\">Past <em>orders.</em></h2>\n        <div class=\"order-card\">\n          <div class=\"thumb\"><img src=\"https://images.unsplash.com/photo-1633934542430-0905ccb5f050?w=300&h=300&fit=crop&auto=format&q=70\" alt=\"Céleste hoops\" /></div>\n          <div>\n            <div class=\"o-num\">Order № AUR-2371</div>\n            <h3 class=\"o-name\">Céleste Hoop · Petite</h3>\n            <div class=\"o-meta\">Placed 12 May 2026 · ₹ 24,600 · Delivered 17 May</div>\n          </div>\n          <div class=\"o-right\">\n            <span class=\"status delivered\"><span class=\"dot\"></span>Delivered</span>\n            <div class=\"o-links\">\n              <a href=\"#\">Invoice</a>\n              <a href=\"#\">Return</a>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- PROFILE -->\n      <section class=\"panel\" id=\"profile\">\n        <h2>Profile.</h2>\n        <div class=\"tile-row\">\n          <div class=\"tile\">\n            <div class=\"t-eyebrow\">Personal information</div>\n            <h3>Ananya Sharma</h3>\n            <p><b>ananya@example.com</b><br />+91 98290 00000<br />Ring size 12 · Prefers 22k gold</p>\n            <div class=\"t-links\"><a href=\"#\">Edit information</a></div>\n          </div>\n          <div class=\"tile\">\n            <div class=\"t-eyebrow\">Security</div>\n            <h3>Password</h3>\n            <p>Last changed 3 months ago.<br />Use 8+ characters with a number and symbol.</p>\n            <div class=\"t-links\"><a href=\"#\">Change password</a></div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ADDRESSES -->\n      <section class=\"panel\" id=\"addresses\">\n        <h2>Addresses.</h2>\n        <div class=\"tile-row\">\n          <div class=\"tile\">\n            <div class=\"t-eyebrow\">Default</div>\n            <h3>Home</h3>\n            <p><b>Ananya Sharma</b><br />14, Prithviraj Road, C-Scheme<br />Jaipur 302001 · +91 98290 00000</p>\n            <div class=\"t-links\">\n              <a href=\"#\">Edit</a>\n              <button class=\"danger\">Delete</button>\n            </div>\n          </div>\n          <button class=\"add-tile\">+ Add new address</button>\n        </div>\n      </section>\n\n      <!-- SAVED CARDS -->\n      <section class=\"panel\" id=\"cards\">\n        <h2>Saved <em>cards.</em></h2>\n        <div class=\"tile-row\">\n          <div class=\"tile plain\">\n            <div class=\"t-eyebrow\">HDFC Bank · Visa</div>\n            <h3>•••• •••• •••• 4821</h3>\n            <p>Expires 08/28 · Ananya Sharma</p>\n            <div class=\"t-links\">\n              <button class=\"danger\">Remove</button>\n            </div>\n          </div>\n          <button class=\"add-tile\">+ Add a card</button>\n        </div>\n      </section>\n\n      <!-- WALLET & REWARDS -->\n      <section class=\"panel\" id=\"wallet\">\n        <h2>Wallet &amp; <em>rewards.</em></h2>\n        <div class=\"tile-row\">\n          <div class=\"tile\">\n            <div class=\"t-eyebrow\">Wallet</div>\n            <h3>₹ 2,400</h3>\n            <p>Store credit from your last exchange. Applies automatically at checkout.</p>\n          </div>\n          <div class=\"tile\">\n            <div class=\"t-eyebrow\">Reward points</div>\n            <h3>1,240 points</h3>\n            <p><b>= ₹ 1,240 off</b> your next piece. Points accrue at 1% of every order value.</p>\n            <div class=\"t-links\"><a href=\"shop.html\">Redeem on a piece</a></div>\n          </div>\n        </div>\n      </section>\n\n      <!-- COUPONS -->\n      <section class=\"panel\" id=\"coupons\">\n        <h2>Coupons.</h2>\n        <div class=\"coupon\">\n          <div>\n            <div class=\"code\">CIRCLE10</div>\n            <div class=\"desc\">10% off making charges · valid till 31 August 2026</div>\n          </div>\n          <button class=\"text-link\" onclick=\"navigator.clipboard && navigator.clipboard.writeText('CIRCLE10'); this.textContent='Copied';\">Copy</button>\n        </div>\n        <div class=\"coupon\">\n          <div>\n            <div class=\"code\">FESTIVE26</div>\n            <div class=\"desc\">₹ 5,000 off orders above ₹ 1,00,000 · Festive Edit</div>\n          </div>\n          <button class=\"text-link\" onclick=\"navigator.clipboard && navigator.clipboard.writeText('FESTIVE26'); this.textContent='Copied';\">Copy</button>\n        </div>\n      </section>\n\n      <!-- NOTIFICATIONS -->\n      <section class=\"panel\" id=\"notifications\">\n        <h2>Notifications.</h2>\n        <div class=\"notif\">\n          <span class=\"dot\"></span>\n          <p><b>Your order AUR-2418 is in transit</b> — insured and sealed, arriving Tuesday.</p>\n          <span class=\"when\">Today</span>\n        </div>\n        <div class=\"notif\">\n          <span class=\"dot\"></span>\n          <p><b>Gold rate update</b> — prices refreshed this morning; bag quotes held 48 hours.</p>\n          <span class=\"when\">Today</span>\n        </div>\n        <div class=\"notif\">\n          <span class=\"dot\"></span>\n          <p><b>FESTIVE26 unlocked</b> — ₹ 5,000 off the Festive Edit for Circle members.</p>\n          <span class=\"when\">2 days ago</span>\n        </div>\n        <div class=\"notif read\">\n          <span class=\"dot\"></span>\n          <p>Your Céleste hoops were delivered. Free polishing anytime — just write to us.</p>\n          <span class=\"when\">17 May</span>\n        </div>\n      </section>\n\n    </main>\n  </div>\n</div>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"code":"\n  document.getElementById('trackToggle').addEventListener('click', function () {\n    var s = document.getElementById('trackStrip');\n    s.classList.toggle('show');\n    this.textContent = s.classList.contains('show') ? 'Hide tracking' : 'Track';\n  });\n  // Sidebar active state on click\n  document.querySelectorAll('.acct-nav a[href^=\"#\"]').forEach(a => {\n    a.addEventListener('click', () => {\n      document.querySelectorAll('.acct-nav a').forEach(x => x.classList.remove('active'));\n      a.classList.add('active');\n    });\n  });\n","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}