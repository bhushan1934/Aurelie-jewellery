{"title":"Aurélie — My Account","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  .auth-hero {\n    padding: 150px 0 40px;\n    border-bottom: 1px solid rgba(162, 142, 102, 0.22);\n  }\n  .auth-hero .kicker {\n    font-size: 10.5px; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold);\n  }\n  .auth-hero h1 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: clamp(32px, 4vw, 54px);\n    line-height: 1.02; letter-spacing: -0.015em; color: var(--navy);\n    margin: 14px 0 12px;\n  }\n  .auth-hero h1 em { font-style: italic; color: var(--gold); font-weight: 400; }\n  .auth-hero p { font-size: 14.5px; color: var(--ink-soft); margin: 0; }\n\n  .auth-layout {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 32px;\n    padding: 72px 0 130px; align-items: start;\n  }\n  @media (max-width: 860px) { .auth-layout { grid-template-columns: 1fr; gap: 24px; } }\n\n  .auth-card {\n    border: 1px solid rgba(162, 142, 102, 0.3);\n    border-radius: var(--r-md);\n    background: rgba(255, 255, 255, 0.5);\n    padding: 44px 44px 48px;\n  }\n  @media (max-width: 560px) { .auth-card { padding: 32px 24px 36px; } }\n  .auth-card h2 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500; font-size: 30px; letter-spacing: -0.01em; color: var(--navy);\n    margin: 0 0 32px;\n  }\n  .auth-card h2 em { font-style: italic; color: var(--gold); font-weight: 400; }\n\n  .field { margin-bottom: 24px; }\n  .field label {\n    display: block; font-size: 11px; font-weight: 600;\n    letter-spacing: 0.16em; text-transform: uppercase; color: var(--navy);\n    margin-bottom: 10px;\n  }\n  .field label .req { color: #a9584f; margin-left: 2px; }\n  .field .control { position: relative; }\n  .field input[type=text], .field input[type=email], .field input[type=password] {\n    width: 100%; box-sizing: border-box;\n    padding: 16px 18px; font-family: 'Manrope', sans-serif; font-size: 15px; color: var(--navy);\n    background: #fff;\n    border: 1px solid rgba(17, 27, 67, 0.14);\n    border-radius: 14px;\n    outline: 0;\n    transition: border-color var(--t) var(--ease), box-shadow var(--t) var(--ease);\n  }\n  .field input::placeholder { color: rgba(17, 27, 67, 0.32); }\n  .field input:focus { border-color: var(--gold); box-shadow: 0 0 0 4px rgba(162, 142, 102, 0.14); }\n  .field .toggle-pw {\n    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);\n    width: 36px; height: 36px; border-radius: 999px; border: 0; background: transparent; cursor: pointer;\n    display: inline-flex; align-items: center; justify-content: center; color: var(--ink-soft);\n    transition: color var(--t) var(--ease), background var(--t) var(--ease);\n  }\n  .field .toggle-pw:hover { color: var(--navy); background: rgba(162, 142, 102, 0.1); }\n  .field .hint { font-size: 12.5px; color: var(--ink-soft); margin: 12px 0 0; line-height: 1.6; }\n\n  /* checkbox + radios */\n  .check { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); font-weight: 500; }\n  .check input { position: absolute; opacity: 0; width: 0; height: 0; }\n  .check .box {\n    width: 18px; height: 18px; border-radius: 5px; border: 1px solid rgba(17, 27, 67, 0.3);\n    display: inline-flex; align-items: center; justify-content: center; background: #fff; flex-shrink: 0;\n    transition: background var(--t) var(--ease), border-color var(--t) var(--ease);\n  }\n  .check .box svg { width: 11px; height: 11px; color: #fff; opacity: 0; transition: opacity var(--t) var(--ease); }\n  .check input:checked + .box { background: var(--navy); border-color: var(--navy); }\n  .check input:checked + .box svg { opacity: 1; }\n\n  .radio-row { display: flex; flex-direction: column; gap: 16px; margin: 26px 0 22px; }\n  .radio { display: inline-flex; align-items: center; gap: 12px; cursor: pointer; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy); font-weight: 600; }\n  .radio input { position: absolute; opacity: 0; width: 0; height: 0; }\n  .radio .dot {\n    width: 18px; height: 18px; border-radius: 999px; border: 1px solid rgba(17, 27, 67, 0.3);\n    display: inline-flex; align-items: center; justify-content: center; background: #fff; flex-shrink: 0;\n    transition: border-color var(--t) var(--ease);\n  }\n  .radio .dot::after { content: ''; width: 9px; height: 9px; border-radius: 999px; background: var(--gold); transform: scale(0); transition: transform var(--t) var(--ease); }\n  .radio input:checked + .dot { border-color: var(--gold); }\n  .radio input:checked + .dot::after { transform: scale(1); }\n\n  .auth-btn {\n    display: inline-flex; align-items: center; gap: 12px;\n    padding: 16px 34px; background: var(--navy); color: #fff;\n    border: 0; border-radius: 999px; cursor: pointer;\n    font-family: 'Manrope', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;\n    transition: transform var(--t) var(--ease), background var(--t) var(--ease), box-shadow var(--t) var(--ease);\n  }\n  .auth-btn:hover { background: var(--navy-deep); transform: translateY(-2px); box-shadow: 0 16px 34px -14px rgba(17, 27, 67, 0.5); }\n\n  .login-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: 30px; }\n  .login-foot .lost {\n    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft);\n    border-bottom: 1px solid transparent; padding-bottom: 2px; transition: color var(--t) var(--ease), border-color var(--t) var(--ease);\n  }\n  .login-foot .lost:hover { color: var(--gold); border-color: var(--gold); }\n\n  .legal-note { font-size: 12.5px; line-height: 1.7; color: var(--ink-soft); margin: 26px 0 30px; }\n  .legal-note a { color: var(--navy); border-bottom: 1px solid var(--gold); }\n\n  /* trust footer strip */\n  .auth-trust {\n    display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;\n    padding: 0 0 120px;\n  }\n  .auth-trust .pill {\n    display: inline-flex; align-items: center; gap: 10px;\n    padding: 10px 18px; border: 1px solid rgba(162, 142, 102, 0.35); border-radius: 999px;\n    background: rgba(255, 255, 255, 0.6);\n    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; color: var(--navy);\n  }\n  .auth-trust .pill svg { width: 14px; height: 14px; color: var(--gold); }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<!-- ==================== HERO ==================== -->\n<section class=\"auth-hero\">\n  <div class=\"wrap reveal\">\n    <span class=\"kicker\">My Account</span>\n    <h1>Welcome back, <em>sign in.</em></h1>\n    <p>Access your orders, saved addresses, and payment methods.</p>\n  </div>\n</section>\n\n<!-- ==================== LOGIN / REGISTER ==================== -->\n<div class=\"wrap\">\n  <div class=\"auth-layout\">\n\n    <!-- LOGIN -->\n    <div class=\"auth-card reveal\">\n      <h2>Login <em>here.</em></h2>\n      <form onsubmit=\"event.preventDefault(); window.location.href='account.html';\">\n        <div class=\"field\">\n          <label>Username or Email Address <span class=\"req\">*</span></label>\n          <div class=\"control\"><input type=\"text\" autocomplete=\"username\" placeholder=\"you@example.com\" required /></div>\n        </div>\n        <div class=\"field\">\n          <label>Password <span class=\"req\">*</span></label>\n          <div class=\"control\">\n            <input type=\"password\" id=\"loginPw\" autocomplete=\"current-password\" placeholder=\"••••••••\" required />\n            <button type=\"button\" class=\"toggle-pw\" data-target=\"loginPw\" aria-label=\"Show password\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n            </button>\n          </div>\n        </div>\n        <label class=\"check\">\n          <input type=\"checkbox\" /><span class=\"box\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"m5 12 5 5 9-11\"/></svg></span>\n          Remember me\n        </label>\n        <div class=\"login-foot\">\n          <button type=\"submit\" class=\"auth-btn\">Log in</button>\n          <a class=\"lost\" href=\"#\">Lost your password?</a>\n        </div>\n      </form>\n    </div>\n\n    <!-- REGISTER -->\n    <div class=\"auth-card reveal delay-1\">\n      <h2>Create <em>account.</em></h2>\n      <form onsubmit=\"event.preventDefault(); window.location.href='account.html';\">\n        <div class=\"field\">\n          <label>Email Address <span class=\"req\">*</span></label>\n          <div class=\"control\"><input type=\"email\" autocomplete=\"email\" placeholder=\"you@example.com\" required /></div>\n          <p class=\"hint\">A link to set a new password will be sent to your email address.</p>\n        </div>\n        <div class=\"radio-row\">\n          <label class=\"radio\">\n            <input type=\"radio\" name=\"role\" checked /><span class=\"dot\"></span> I am a customer\n          </label>\n          <label class=\"radio\">\n            <input type=\"radio\" name=\"role\" /><span class=\"dot\"></span> I am a vendor\n          </label>\n        </div>\n        <p class=\"legal-note\">Your personal data will be used to support your experience throughout this website, to manage access to your account, and for other purposes described in our <a href=\"privacy.html\">privacy policy</a>.</p>\n        <button type=\"submit\" class=\"auth-btn\">Register</button>\n      </form>\n    </div>\n\n  </div>\n</div>\n\n<!-- ==================== TRUST STRIP ==================== -->\n<div class=\"wrap\">\n  <div class=\"auth-trust reveal\">\n    <span class=\"pill\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></svg> Secure Encrypted Login</span>\n    <span class=\"pill\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6Z\"/></svg> Your Data, Protected</span>\n    <span class=\"pill\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8 12 3 3 5-6\"/></svg> BIS Hallmarked Jewellery</span>\n  </div>\n</div>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"code":"\n  document.querySelectorAll('.toggle-pw').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      var input = document.getElementById(this.dataset.target);\n      var show = input.type === 'password';\n      input.type = show ? 'text' : 'password';\n      this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');\n    });\n  });\n","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}