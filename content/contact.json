{"title":"Aurélie — Contact the Atelier","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  /* ====== BANNER HERO ====== */\n  .contact-hero {\n    position: relative;\n    height: 62vh;\n    min-height: 420px;\n    display: flex; align-items: center; justify-content: center;\n    text-align: center;\n    overflow: hidden;\n  }\n  .contact-hero img {\n    position: absolute; inset: 0;\n    width: 100%; height: 100%; object-fit: cover;\n  }\n  .contact-hero::after {\n    content: ''; position: absolute; inset: 0;\n    background: rgba(9, 13, 28, 0.46);\n  }\n  .contact-hero .inner { position: relative; z-index: 2; padding: 0 24px; }\n  .contact-hero .eyebrow { color: var(--gold-soft); }\n  .contact-hero h1 {\n    font-family: 'Playfair Display', serif;\n    font-weight: 500;\n    font-size: clamp(38px, 5vw, 68px);\n    line-height: 1.04;\n    letter-spacing: -0.02em;\n    color: #fff;\n    margin: 16px 0 0;\n  }\n  .contact-hero h1 em { font-style: italic; color: var(--gold-soft); font-weight: 400; }\n\n  /* ====== BODY ====== */\n  .contact-layout {\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    gap: 96px;\n    padding: 96px 0;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n  @media (max-width: 900px) { .contact-layout { grid-template-columns: 1fr; gap: 64px; padding: 64px 0 48px; } }\n\n  .c-label {\n    font-family: 'Manrope', sans-serif;\n    font-size: 12px; font-weight: 600;\n    letter-spacing: 0.26em; text-transform: uppercase;\n    color: var(--gold);\n    display: block;\n    margin-bottom: 28px;\n  }\n\n  /* Minimal underline form */\n  .m-field { margin-bottom: 34px; }\n  .m-field label {\n    display: block;\n    font-size: 11px; font-weight: 500;\n    letter-spacing: 0.2em; text-transform: uppercase;\n    color: var(--ink-soft);\n    margin-bottom: 6px;\n  }\n  .m-field input, .m-field select, .m-field textarea {\n    width: 100%;\n    border: 0; outline: 0;\n    border-bottom: 1px solid rgba(162, 142, 102, 0.45);\n    background: transparent;\n    font-family: inherit;\n    font-size: 16px;\n    color: var(--navy);\n    padding: 8px 0 12px;\n    border-radius: 0;\n    transition: border-color var(--t) var(--ease);\n    appearance: none; -webkit-appearance: none;\n  }\n  .m-field input:focus, .m-field select:focus, .m-field textarea:focus { border-color: var(--gold); }\n  .m-field textarea { resize: vertical; min-height: 96px; }\n  .m-row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }\n  @media (max-width: 560px) { .m-row { grid-template-columns: 1fr; } }\n\n  /* Visit column — plain text blocks */\n  .visit-block { margin-bottom: 44px; }\n  .visit-block h3 {\n    font-family: 'Playfair Display', serif;\n    font-size: 21px; font-weight: 500;\n    color: var(--navy);\n    margin: 0 0 10px;\n  }\n  .visit-block p { font-size: 15px; line-height: 1.9; color: var(--ink-soft); margin: 0; }\n  .visit-block p b { color: var(--navy); font-weight: 600; }\n  .visit-block .text-link { display: inline-block; margin-top: 14px; }\n\n  /* Map */\n  .map-wrap { padding: 0 0 130px; }\n  .map-card {\n    border-radius: var(--r-md);\n    overflow: hidden;\n    position: relative;\n    height: 420px;\n    box-shadow: 0 0 0 1px rgba(162, 142, 102, 0.25);\n  }\n  .map-card iframe {\n    position: absolute; inset: 0; width: 100%; height: 100%; border: 0;\n    filter: sepia(0.22) saturate(0.82);\n  }\n  .map-card .map-tag {\n    position: absolute; left: 20px; bottom: 20px; z-index: 2;\n    background: rgba(251, 248, 243, 0.95);\n    border: 1px solid rgba(162, 142, 102, 0.3);\n    border-radius: 16px;\n    padding: 12px 18px;\n  }\n  .map-card .map-tag .m-eyebrow { font-size: 9px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--gold); font-weight: 600; }\n  .map-card .map-tag .m-name { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 500; color: var(--navy); }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<!-- ==================== BANNER ==================== -->\n<section class=\"contact-hero\">\n  <img src=\"https://images.unsplash.com/photo-1583292650898-7d22cd27ca6f?w=2000&h=1100&fit=crop&auto=format&q=85\" alt=\"Inside the Aurélie atelier\" />\n  <div class=\"inner\">\n    <span class=\"eyebrow\">Contact</span>\n    <h1>Speak to the <em>atelier.</em></h1>\n  </div>\n</section>\n\n<div class=\"wrap\">\n  <div class=\"contact-layout\">\n\n    <!-- FORM -->\n    <div>\n      <span class=\"c-label\">Send us a note</span>\n      <form onsubmit=\"event.preventDefault(); this.innerHTML = '<p style=\\'font-family: Playfair Display, serif; font-style: italic; font-size: 21px; color: var(--navy);\\'>Thank you — we will reply within one working day.</p>';\">\n        <div class=\"m-row\">\n          <div class=\"m-field\">\n            <label for=\"c-name\">Name</label>\n            <input id=\"c-name\" type=\"text\" required />\n          </div>\n          <div class=\"m-field\">\n            <label for=\"c-phone\">Phone</label>\n            <input id=\"c-phone\" type=\"tel\" />\n          </div>\n        </div>\n        <div class=\"m-field\">\n          <label for=\"c-email\">Email</label>\n          <input id=\"c-email\" type=\"email\" required />\n        </div>\n        <div class=\"m-field\">\n          <label for=\"c-subject\">How can we help?</label>\n          <select id=\"c-subject\">\n            <option>A question about a piece</option>\n            <option>Bespoke commission</option>\n            <option>Book a private viewing</option>\n            <option>Order &amp; shipping</option>\n            <option>Returns &amp; lifetime service</option>\n            <option>Something else</option>\n          </select>\n        </div>\n        <div class=\"m-field\">\n          <label for=\"c-msg\">Message</label>\n          <textarea id=\"c-msg\"></textarea>\n        </div>\n        <button class=\"cta-btn\" type=\"submit\">Send message <span class=\"arrow\"></span></button>\n      </form>\n    </div>\n\n    <!-- VISIT -->\n    <div>\n      <span class=\"c-label\">Visit &amp; reach us</span>\n      <div class=\"visit-block\">\n        <h3>Aurélie Atelier, Jaipur</h3>\n        <p>Civil Lines, Jaipur, Rajasthan<br />\n        <b>Mon – Sat</b> · 11 am – 7 pm IST · by appointment</p>\n        <a class=\"text-link\" href=\"#\">Book a private viewing</a>\n      </div>\n      <div class=\"visit-block\">\n        <h3>Write or call</h3>\n        <p><b>care@aurelie.com</b><br />\n        <b>+91 141 000 0000</b> · 10 am – 8 pm IST<br />\n        WhatsApp on the same number.</p>\n      </div>\n      <div class=\"visit-block\">\n        <h3>We reply within a day</h3>\n        <p>Every note is answered by a member of the atelier — not a bot — within one working day.</p>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- MAP -->\n  <div class=\"map-wrap\">\n    <div class=\"map-card\">\n      <iframe title=\"Aurélie Atelier — Civil Lines, Jaipur\" src=\"https://maps.google.com/maps?q=Civil%20Lines%2C%20Jaipur%2C%20Rajasthan&z=14&output=embed\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>\n      <div class=\"map-tag\">\n        <div class=\"m-eyebrow\">Visit us</div>\n        <div class=\"m-name\">Aurélie Atelier · Civil Lines</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}