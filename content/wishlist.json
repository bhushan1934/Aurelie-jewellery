{"title":"Aurélie — Your Wishlist","html":"\n\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"assets/aurelie.css\" />\n<style>\n  .wl-main { padding: 64px 0 130px; }\n  .wl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 44px 28px; }\n  @media (max-width: 1100px) { .wl-grid { grid-template-columns: repeat(2, 1fr); } }\n  @media (max-width: 520px)  { .wl-grid { grid-template-columns: 1fr; } }\n\n  .product .remove {\n    position: absolute; top: 16px; right: 16px; z-index: 2;\n    width: 38px; height: 38px; border-radius: var(--r-pill);\n    background: rgba(251, 248, 243, 0.9); backdrop-filter: blur(8px);\n    display: inline-flex; align-items: center; justify-content: center;\n    color: var(--navy); font-size: 18px;\n    transition: all var(--t) var(--ease);\n  }\n  .product .remove:hover { background: #fff; color: var(--gold); transform: rotate(90deg); }\n  .product .move-bag {\n    position: absolute; left: 16px; right: 16px; bottom: 16px; z-index: 2;\n    padding: 14px; background: rgba(17, 27, 67, 0.92); color: #fff; border-radius: var(--r-pill);\n    font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 500;\n    opacity: 0; transform: translateY(10px);\n    transition: all var(--t) var(--ease); text-align: center;\n  }\n  .product:hover .move-bag { opacity: 1; transform: none; }\n\n  .wl-empty { text-align: center; padding: 90px 0; display: none; }\n  .wl-empty .orn { font-family: 'Playfair Display', serif; font-style: italic; font-size: 44px; color: var(--gold); line-height: 1; margin-bottom: 16px; }\n  .wl-empty p { color: var(--ink-soft); margin: 0 0 28px; }\n  .wl-note {\n    margin-top: 56px; padding: 28px 32px;\n    background: var(--bg-warm); border-radius: var(--r-md);\n    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;\n  }\n  .wl-note p { margin: 0; font-size: 14px; color: var(--ink-soft); max-width: 560px; }\n  .wl-note p b { color: var(--navy); font-weight: 600; }\n</style>\n\n\n\n<div id=\"site-nav\"></div>\n\n<section class=\"page-hero\">\n  <div class=\"wrap\">\n    <div class=\"breadcrumb\">\n      <a href=\"Shail.html\">Home</a><span class=\"sep\">/</span><span class=\"here\">Wishlist</span>\n    </div>\n    <h1>Pieces you're <em>dreaming of.</em></h1>\n    <p class=\"lede\"><span id=\"wlCount\">4</span> saved pieces — kept safe here until you're ready.</p>\n  </div>\n</section>\n\n<div class=\"wrap wl-main\">\n  <div class=\"wl-grid\" id=\"wlGrid\">\n    <div class=\"product reveal\">\n      <div class=\"imgbox\">\n        <span class=\"badge\">New</span>\n        <button class=\"remove\" aria-label=\"Remove from wishlist\">×</button>\n        <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Solène drop earrings\" loading=\"lazy\" />\n        <a class=\"move-bag\" href=\"cart.html\">Move to bag</a>\n      </div>\n      <div class=\"info\">\n        <div><h4 class=\"name\"><a href=\"product.html\">Solène Drop Earrings</a></h4><div class=\"karat\">22k Gold · 0.4ct Diamond</div></div>\n        <div class=\"price\">₹ 86,400</div>\n      </div>\n    </div>\n    <div class=\"product reveal delay-1\">\n      <div class=\"imgbox\">\n        <button class=\"remove\" aria-label=\"Remove from wishlist\">×</button>\n        <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Maharani choker\" loading=\"lazy\" />\n        <a class=\"move-bag\" href=\"cart.html\">Move to bag</a>\n      </div>\n      <div class=\"info\">\n        <div><h4 class=\"name\"><a href=\"product.html\">Maharani Choker</a></h4><div class=\"karat\">22k Gold · Uncut Polki</div></div>\n        <div class=\"price\">₹ 4,80,000</div>\n      </div>\n    </div>\n    <div class=\"product reveal delay-2\">\n      <div class=\"imgbox\">\n        <span class=\"badge\">Best Seller</span>\n        <button class=\"remove\" aria-label=\"Remove from wishlist\">×</button>\n        <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1633934542430-0905ccb5f050?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Céleste hoops\" loading=\"lazy\" />\n        <a class=\"move-bag\" href=\"cart.html\">Move to bag</a>\n      </div>\n      <div class=\"info\">\n        <div><h4 class=\"name\"><a href=\"product.html\">Céleste Hoop · Petite</a></h4><div class=\"karat\">22k Solid Gold</div></div>\n        <div class=\"price\">₹ 24,600</div>\n      </div>\n    </div>\n    <div class=\"product reveal delay-2\">\n      <div class=\"imgbox\">\n        <button class=\"remove\" aria-label=\"Remove from wishlist\">×</button>\n        <img class=\"ph-img\" src=\"https://images.unsplash.com/photo-1573408301185-9146fe634ad0?w=700&h=900&fit=crop&auto=format&q=80\" alt=\"Aria stacking band\" loading=\"lazy\" />\n        <a class=\"move-bag\" href=\"cart.html\">Move to bag</a>\n      </div>\n      <div class=\"info\">\n        <div><h4 class=\"name\"><a href=\"product.html\">Aria Stacking Band</a></h4><div class=\"karat\">18k Gold · Diamond Pavé</div></div>\n        <div class=\"price\">₹ 38,200</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"wl-empty\" id=\"wlEmpty\">\n    <div class=\"orn\">Aurélie</div>\n    <p>Your wishlist is empty — but the atelier is full.</p>\n    <a class=\"cta-btn\" href=\"shop.html\">Explore the collection <span class=\"arrow\"></span></a>\n  </div>\n\n  <div class=\"wl-note reveal\">\n    <p><b>Prices move with gold.</b> Wishlisted pieces are re-priced daily against the market rate — we'll hold a quoted price for 48 hours when you move a piece to your bag.</p>\n    <a class=\"text-link\" href=\"shop.html\">Continue shopping</a>\n  </div>\n</div>\n\n<div id=\"site-footer\"></div>\n\n\n\n\n\n\n","scripts":[{"src":"assets/aurelie.js","type":""},{"code":"\n  const grid = document.getElementById('wlGrid');\n  grid.addEventListener('click', (e) => {\n    const btn = e.target.closest('.remove');\n    if (!btn) return;\n    const card = btn.closest('.product');\n    card.style.transition = 'opacity 0.4s, transform 0.4s';\n    card.style.opacity = 0; card.style.transform = 'scale(0.96)';\n    setTimeout(() => {\n      card.remove();\n      const left = grid.querySelectorAll('.product').length;\n      document.getElementById('wlCount').textContent = left;\n      if (!left) {\n        grid.style.display = 'none';\n        document.getElementById('wlEmpty').style.display = 'block';\n      }\n    }, 380);\n  });\n","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js","type":""},{"src":"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js","type":""},{"src":"assets/aurelie-gsap.js","type":""}]}